[Unit]
Description=proxmox-ai backend (LLM broker + Proxmox administration)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxmox-ai
Group=proxmox-ai
WorkingDirectory=/opt/proxmox-ai/backend
ExecStart=/opt/proxmox-ai/venv/bin/uvicorn app:app --host 0.0.0.0 --port 9000
Restart=on-failure
RestartSec=10
# hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/proxmox-ai /var/log/proxmox-ai /var/lib/proxmox-ai

[Install]
WantedBy=multi-user.target
